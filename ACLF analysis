select_predictors <- function(training_missing, external_missing, varies, threshold = MISSING_THRESHOLD) {
    stopifnot(identical(names(training_missing), names(external_missing)), identical(names(training_missing), names(varies)))
    names(training_missing)[is.finite(training_missing) & is.finite(external_missing) & training_missing <= threshold & external_missing <= 
        threshold & varies]
}

fit_prep <- function(df, seed, label) {
    miss <- vapply(df[, CANDIDATES, drop = FALSE], function(x) mean(is.na(x)), 0)
    varies <- vapply(df[, CANDIDATES, drop = FALSE], function(x) length(unique(na.omit(x))) > 1, TRUE)
    vars <- select_predictors(miss, EXTERNAL_MISSING, varies)
    stopifnot(length(vars) >= 3)
    stopifnot(all(miss[vars] <= MISSING_THRESHOLD), all(EXTERNAL_MISSING[vars] <= MISSING_THRESHOLD))
    d <- df[, vars, drop = FALSE]
    med <- vapply(d, median, na.rm = TRUE, FUN.VALUE = 0)
    meth <- setNames(rep("pmm", length(vars)), vars)
    meth[vapply(d, function(x) !anyNA(x), TRUE)] <- ""
    pred <- mice::make.predictorMatrix(d)
    cors <- abs(cor(d, use = "pairwise.complete.obs"))
    cors[!is.finite(cors)] <- 0
    for (j in seq_along(vars)) {
        chosen <- head(order(cors[j, ], decreasing = TRUE)[order(cors[j, ], decreasing = TRUE) != j], 12L)
        pred[j, ] <- 0
        pred[j, chosen] <- 1
    }
    init <- d
    for (v in vars) init[[v]][is.na(init[[v]])] <- med[v]
    imp <- mice::mice(d, m = M, maxit = MAXIT, method = meth, predictorMatrix = pred, data.init = init, printFlag = FALSE, 
        seed = seed, remove.collinear = FALSE, remove.constant = FALSE)
    comp <- mice::complete(imp, "all")
    fallbacks <- 0L
    transform_values <- function(z) {
        for (v in vars) {
            bad <- !is.finite(z[[v]])
            fallbacks <<- fallbacks + sum(bad)
            z[[v]][bad] <- med[v]
            if (v %in% TRANSFORM_LOG) 
                z[[v]] <- log1p(pmax(z[[v]], 0))
        }
        as.matrix(z[, vars, drop = FALSE])
    }
    mats <- lapply(comp, transform_values)
    center <- colMeans(Reduce("+", mats)/M)
    scale <- sqrt(Reduce("+", lapply(mats, function(x) colMeans(sweep(x, 2, center, "-")^2)))/M)
    scale[!is.finite(scale) | scale < 1e-08] <- 1
    norm <- function(x) sweep(sweep(x, 2, center, "-"), 2, scale, "/")
    if (!is.null(imp$loggedEvents)) 
        write_csv(imp$loggedEvents, paste0(label, "_MICE事件.csv"), DIRS["audit"])
    if (fallbacks) 
        logmsg(label, "MICE residual missing fallback cells:", fallbacks)
    list(vars = vars, med = med, mids = imp, center = center, scale = scale, train = lapply(mats, norm), completed = comp, 
        training_missing = miss, external_missing = EXTERNAL_MISSING, availability_policy = MODEL_POLICY, seed = seed, fallback_cells = fallbacks)
}

apply_prep <- function(prep, new_df) {
    z <- new_df[, prep$vars, drop = FALSE]
    imp <- prep$mids
    for (v in prep$vars) {
        if (anyNA(z[[v]]) && !nzchar(imp$method[v])) 
            imp$method[v] <- "pmm"
    }
    newimp <- mice::mice.mids(imp, newdata = z, maxit = MAXIT, printFlag = FALSE)
    stopifnot(nrow(newimp$data) == nrow(z), all(newimp$ignore))
    comp <- mice::complete(newimp, "all")
    n_fallback <- 0L
    mats <- lapply(comp, function(d) {
        for (v in prep$vars) {
            bad <- !is.finite(d[[v]])
            n_fallback <<- n_fallback + sum(bad)
            d[[v]][bad] <- prep$med[v]
            if (v %in% TRANSFORM_LOG) 
                d[[v]] <- log1p(pmax(d[[v]], 0))
        }
        x <- as.matrix(d[, prep$vars, drop = FALSE])
        sweep(sweep(x, 2, prep$center, "-"), 2, prep$scale, "/")
    })
    if (n_fallback) 
        logmsg("new-data MICE residual missing fallback cells:", n_fallback)
    list(matrices = mats, completed = comp, fallback_cells = n_fallback)
}

pack_catboost <- function(model) {
