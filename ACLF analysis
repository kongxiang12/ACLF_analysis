manuscript_plot_reduction_path <- function(d, partition = "full", title = "Predictor reduction within MIMIC") {
    d <- manuscript_plot_alias(d, "mean_logloss", c("fold_mean_logloss", "mean_LogLoss", "LogLoss"))
    d <- manuscript_plot_alias(d, "se", c("fold_SE", "SE", "logloss_se"))
    d <- manuscript_plot_alias(d, "k", c("nvars", "n_variables"))
    manuscript_plot_require(d, c("family", "k", "mean_logloss", "se"), "reduction path data")
    if ("partition" %in% names(d) && !is.null(partition)) {
        if (!partition %in% d$partition) 
            stop("Requested reduction partition not found: ", partition)
        d <- d[d$partition == partition, , drop = FALSE]
    }
    g <- ggplot2::ggplot(d, ggplot2::aes(k, mean_logloss, colour = family, group = family)) + ggplot2::geom_errorbar(ggplot2::aes(ymin = mean_logloss - 
        se, ymax = mean_logloss + se), width = 0.5, linewidth = 0.4) + ggplot2::geom_line(linewidth = 0.7) + ggplot2::geom_point(size = 2) + 
