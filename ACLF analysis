apply_prep <- function(prep, new_df) {
    z <- new_df[, prep$vars, drop = FALSE]
    imp <- prep$mids
    for (v in prep$vars) {
        if (anyNA(z[[v]]) && !nzchar(imp$method[v])) 
            imp$method[v] <- "pmm"
    }
    newimp <- mice::mice.mids(imp, newdata = z, maxit = MAXIT, printFlag = FALSE)
    stopifnot(nrow(newimp$data) == nrow(z), all(newimp$ignore))
    if (nrow(z) == 1L && is.null(dim(newimp$where))) {
        dim(newimp$where) <- dim(z)
        dimnames(newimp$where) <- dimnames(newimp$data)
    }
    comp <- mice::complete(newimp, "all")
    n_fallback <- 0L
    mats <- lapply(comp, function(d) {
        for (v in prep$vars) {
            bad <- !is.finite(d[[v]])
            n_fallback <<- n_fallback + sum(bad)
            d[[v]][bad] <- prep$med[v]
            if (v %in% TRANSFORM_LOG) 
                d[[v]] <- log1p(pmax(d[[v]], 0))
        }
        x <- as.matrix(d[, prep$vars, drop = FALSE])
        sweep(sweep(x, 2, prep$center, "-"), 2, prep$scale, "/")
    })
    if (n_fallback) 
        logmsg("new-data MICE residual missing fallback cells:", n_fallback)
    list(matrices = mats, completed = comp, fallback_cells = n_fallback)
}

fit_one <- function(name, x, y, param, seed) {
    set.seed(seed)
    if (name == "ElasticNet") {
        return(glmnet::glmnet(x, y, family = "binomial", alpha = param$alpha, lambda = param$lambda, standardize = FALSE, 
            intercept = TRUE, control = list(thresh = 1e-08, maxit = 1e+05)))
    }
    if (name == "LightGBM") 
        return(lightgbm::lgb.train(params = list(objective = "binary", metric = "binary_logloss", learning_rate = 0.04, num_leaves = param$num_leaves, 
            max_depth = 4L, min_data_in_leaf = 30L, feature_fraction = 0.8, bagging_fraction = 0.8, bagging_freq = 1L, lambda_l2 = 2, 
            deterministic = TRUE, force_col_wise = TRUE, seed = seed, num_threads = THREADS, verbosity = -1L), data = lightgbm::lgb.Dataset(x, 
            label = y), nrounds = param$nrounds, verbose = -1L, record = FALSE, serializable = TRUE))
    stop("Unknown base model: ", name)
}

pred_one <- function(name, fit, x, param) {
    if (name == "ElasticNet") 
        return(as.numeric(predict(fit, newx = x, s = param$lambda, type = "response")))
    if (name == "LightGBM") 
        return(as.numeric(predict(fit, x)))
    stop("Unknown base model: ", name)
}

fit_ensemble <- function(name, mats, y, param, seed) lapply(seq_len(M), function(j) fit_one(name, mats[[j]], y, param, seed + 
    j))

predict_ensemble <- function(name, fits, mats, param) {
    p <- Reduce("+", lapply(seq_len(M), function(j) pred_one(name, fits[[j]], mats[[j]], param)))/M
    stopifnot(length(p) == nrow(mats[[1]]), all(is.finite(p)), all(p >= 0 & p <= 1))
    clip(p)
}

grid <- list(
    ElasticNet = expand.grid(alpha = c(0.1, 0.5, 1), lambda = c(0.001, 0.01, 0.1)),
    LightGBM = expand.grid(num_leaves = c(7L, 15L), nrounds = c(150L, 300L))
)

subset_seed <- function(seed, k) seed + 50000L + 100L * k

ordered_top <- function(vars, score, k) {
    stopifnot(length(vars) == length(score), !anyNA(score), length(vars) >= k)
    picked <- vars[order(-score, seq_along(vars), method = "radix")[seq_len(k)]]
    vars[vars %in% picked]
}

get_paths <- function(d, y, fullprep, prep_seed, screen_seed, label, min_k = 6L) {
    vars <- fullprep$vars
    stopifnot(length(vars) >= 3L)
    cache <- new.env(parent = emptyenv())
    getprep <- function(v) {
        v <- vars[vars %in% v]
        key <- paste(v, collapse = "|")
        if (identical(v, vars)) 
            return(fullprep)
        if (exists(key, cache, inherits = FALSE)) 
            return(get(key, cache))
        z <- fit_subset_prep(d, v, subset_seed(prep_seed, length(v)), paste0(label, "_k", length(v)))
        stopifnot(identical(z$vars, v), identical(colnames(z$mids$data), v), all(colnames(z$train[[1]]) == v))
        assign(key, z, cache)
        z
    }
    paths <- setNames(lapply(FAMILIES, function(x) list(full = vars)), FAMILIES)
    audit <- list()
    qi <- 1L
    coefmat <- sapply(seq_len(M), function(j) {
        f <- fit_one("ElasticNet", fullprep$train[[j]], y, data.frame(alpha = 0.5, lambda = 0.01), screen_seed + j)
        as.numeric(as.matrix(coef(f, s = 0.01))[-1, 1])
    })
    rms <- sqrt(rowMeans(coefmat^2))
    freq <- rowMeans(abs(coefmat) > 1e-10)
    audit[[qi]] <- data.frame(family = "ElasticNet", stage_k = length(vars), variable = vars, importance = rms, nonzero_frequency = freq)
    qi <- qi + 1L
    for (k in BUDGETS[BUDGETS < length(vars) & BUDGETS >= min_k]) paths$ElasticNet[[as.character(k)]] <- ordered_top(vars, 
        rms, k)
    current <- vars
    for (k in sort(BUDGETS[BUDGETS < length(vars) & BUDGETS >= min_k], decreasing = TRUE)) {
        pr <- getprep(current)
        imp <- sapply(seq_len(M), function(j) {
            f <- fit_one("LightGBM", pr$train[[j]], y, data.frame(num_leaves = 15L, nrounds = 300L), screen_seed + 20000L + 
                100L * length(current) + j)
            z <- as.matrix(predict(f, pr$train[[j]], type = "contrib"))
            stopifnot(is.matrix(z), ncol(z) == length(current) + 1L, nrow(z) == length(y))
            colMeans(abs(z[, seq_along(current), drop = FALSE]))
        })
        avg <- rowMeans(imp)
        audit[[qi]] <- data.frame(family = "LightGBM", stage_k = length(current), variable = current, importance = avg, nonzero_frequency = NA_real_)
        qi <- qi + 1L
        current <- ordered_top(current, avg, k)
        current <- vars[vars %in% current]
        paths$LightGBM[[as.character(k)]] <- current
    }
    list(paths = paths, getprep = getprep, ranking = do.call(rbind, audit))
}

choose_one_se <- function(scores) {
    best <- which.min(scores$fold_mean_logloss)
    cutoff <- scores$fold_mean_logloss[best] + scores$fold_SE[best]
    ok <- which(scores$fold_mean_logloss <= cutoff + 1e-12)
    selected <- ok[order(scores$k[ok], scores$fold_mean_logloss[ok], scores$grid_id[ok], method = "radix")[1]]
    list(row = scores[selected, , drop = FALSE], best_row = scores[best, , drop = FALSE], cutoff = cutoff)
}

inner_slim <- function(d, y, seed, label) {
    folds <- strat_folds(y, K_INNER, seed)
    chunks <- vector("list", K_INNER)
    for (j in seq_len(K_INNER)) {
        path <- file.path(DIRS["audit"], paste0(label, "_inner", j, ".rds"))
        if (file.exists(path)) {
            obj <- readRDS(path)
            if (identical(obj$fingerprint, FINGERPRINT) && identical(obj$fold, folds) && identical(obj$patients, d$patient_id)) {
                chunks[[j]] <- obj
                logmsg("RESTORED", label, "inner", j)
                next
            }
            logmsg("RETRAIN STALE CHECKPOINT", label, "inner", j)
        }
        tr <- which(folds != j)
        va <- which(folds == j)
        logmsg(label, "inner", j, "of", K_INNER, "train", length(tr), "validate", length(va))
        prep_seed <- seed + 100L * j
        fullprep <- fit_prep(d[tr, , drop = FALSE], prep_seed, paste0(label, "_inner", j, "_full"))
        stopifnot(length(fullprep$vars) >= 3L)
        fullval <- apply_prep(fullprep, d[va, , drop = FALSE])$matrices
        pred <- setNames(lapply(FAMILIES, function(nm) list()), FAMILIES)
        for (nm in FAMILIES) {
            z <- matrix(NA_real_, length(va), nrow(grid[[nm]]))
            for (g in seq_len(nrow(grid[[nm]]))) {
                fits <- fit_ensemble(nm, fullprep$train, y[tr], grid[[nm]][g, , drop = FALSE], seed + 1000L * j + 100L * 
                  g)
                z[, g] <- predict_ensemble(nm, fits, fullval, grid[[nm]][g, , drop = FALSE])
            }
            pred[[nm]][["full"]] <- z
        }
        ps <- get_paths(d[tr, , drop = FALSE], y[tr], fullprep, prep_seed, seed + 100000L + 1000L * j, paste0(label, "_screen", 
            j))
        for (nm in FAMILIES) for (k in BUDGETS[BUDGETS < length(fullprep$vars)]) {
            v <- ps$paths[[nm]][[as.character(k)]]
            pr <- ps$getprep(v)
            val <- apply_prep(pr, d[va, , drop = FALSE])$matrices
            z <- matrix(NA_real_, length(va), nrow(grid[[nm]]))
            for (g in seq_len(nrow(grid[[nm]]))) {
                fits <- fit_ensemble(nm, pr$train, y[tr], grid[[nm]][g, , drop = FALSE], seed + 200000L + 1000L * j + 100L * 
                  k + g)
                z[, g] <- predict_ensemble(nm, fits, val, grid[[nm]][g, , drop = FALSE])
            }
            pred[[nm]][[as.character(k)]] <- z
            logmsg(label, "inner", j, nm, "k", k, "finished")
        }
        obj <- list(idx = va, pred = pred, paths = ps$paths, ranking = ps$ranking, fold = folds, patients = d$patient_id, 
            fingerprint = FINGERPRINT)
        saveRDS(obj, path)
        chunks[[j]] <- obj
        rm(ps, fullprep, fullval, pr, val, fits)
        invisible(gc(FALSE))
    }
    scores <- list()
    predictions <- setNames(lapply(FAMILIES, function(x) list()), FAMILIES)
    choices <- list()
    q <- 1L
    for (nm in FAMILIES) {
        famscores <- list()
        keys <- Reduce(intersect, lapply(chunks, function(z) names(z$pred[[nm]])))
        for (key in keys) {
            k <- if (key == "full") 
                length(select_predictors(vapply(d[, CANDIDATES, drop = FALSE], function(x) mean(is.na(x)), 0), EXTERNAL_MISSING, 
                  vapply(d[, CANDIDATES, drop = FALSE], function(x) length(unique(na.omit(x))) > 1, TRUE)))
            else as.integer(key)
            pp <- matrix(NA_real_, length(y), nrow(grid[[nm]]))
            for (j in seq_len(K_INNER)) pp[chunks[[j]]$idx, ] <- chunks[[j]]$pred[[nm]][[key]]
            stopifnot(all(is.finite(pp)))
            predictions[[nm]][[key]] <- pp
            fl <- sapply(seq_len(ncol(pp)), function(g) vapply(seq_len(K_INNER), function(j) ll(y[folds == j], pp[folds == 
                j, g]), 0))
            z <- data.frame(family = nm, k = k, budget_key = key, grid_id = seq_len(ncol(pp)), grid[[nm]], pooled_logloss = apply(pp, 
                2, function(p) ll(y, p)), fold_mean_logloss = colMeans(fl), fold_SE = apply(fl, 2, sd)/sqrt(K_INNER), inner_AUC = apply(pp, 
                2, function(p) auc(y, p)), check.names = FALSE)
            famscores[[key]] <- z
        }
        sc <- do.call(rbind, famscores)
        rownames(sc) <- NULL
        full <- sc[sc$budget_key == "full", , drop = FALSE]
        full <- full[which.min(full$pooled_logloss), , drop = FALSE]
        reduced <- choose_one_se(sc)
        choices[[nm]] <- list(full = full, reduced = reduced$row, cutoff = reduced$cutoff, best = reduced$best_row)
        scores[[q]] <- sc
        q <- q + 1L
    }
    bind_rows <- function(xs) {
        cols <- unique(unlist(lapply(xs, names)))
        xs <- lapply(xs, function(z) {
            for (v in setdiff(cols, names(z))) z[[v]] <- NA
            z[, cols, drop = FALSE]
        })
        do.call(rbind, xs)
    }
    list(choices = choices, scores = bind_rows(scores), predictions = predictions, chunks = chunks, fold = folds)
}

fit_partition <- function(d, y, tune, prep_seed, fit_seed, screen_seed, label, new_df = NULL) {
    fullprep <- fit_prep(d, prep_seed, paste0(label, "_full"))
    fullval <- if (!is.null(new_df)) 
        apply_prep(fullprep, new_df)$matrices
    else NULL
    locks <- list()
    pred <- if (!is.null(new_df)) 
        matrix(NA_real_, nrow(new_df), length(MODEL_NAMES), dimnames = list(NULL, MODEL_NAMES))
    else NULL
    for (nm in FAMILIES) {
        row <- tune$choices[[nm]]$full
        param <- grid[[nm]][row$grid_id, , drop = FALSE]
        fits <- fit_ensemble(nm, fullprep$train, y, param, fit_seed)
        locks[[paste0(nm, "_Full")]] <- list(family = nm, prep = fullprep, param = param, fits = fits, k = length(fullprep$vars))
        if (!is.null(new_df)) 
            pred[, paste0(nm, "_Full")] <- predict_ensemble(nm, fits, fullval, param)
    }
    mink <- min(vapply(FAMILIES, function(nm) tune$choices[[nm]]$reduced$k, 0))
    ps <- get_paths(d, y, fullprep, prep_seed, screen_seed, paste0(label, "_finalscreen"), min_k = mink)
    for (nm in FAMILIES) {
        row <- tune$choices[[nm]]$reduced
        k <- row$k
        v <- ps$paths[[nm]][[row$budget_key]]
        pr <- ps$getprep(v)
        param <- grid[[nm]][row$grid_id, , drop = FALSE]
        fits <- fit_ensemble(nm, pr$train, y, param, fit_seed + 200000L + 100L * k)
        locks[[paste0(nm, "_Reduced")]] <- list(family = nm, prep = pr, param = param, fits = fits, k = k)
        stopifnot(length(pr$vars) == k, identical(pr$vars, colnames(pr$mids$data)))
        if (!is.null(new_df)) 
            pred[, paste0(nm, "_Reduced")] <- predict_ensemble(nm, fits, apply_prep(pr, new_df)$matrices, param)
    }
    list(models = locks[MODEL_NAMES], pred = pred, ranking = ps$ranking)
}

