inner_select <- function(d, y, seed, label) {
    folds <- strat_folds(y, K_INNER, seed)
    pred <- lapply(BASE, function(nm) matrix(NA_real_, length(y), nrow(grid[[nm]])))
    names(pred) <- BASE
    for (k in seq_len(K_INNER)) {
        tr <- which(folds != k)
        va <- which(folds == k)
        logmsg(label, "inner", k, "of", K_INNER, "train", length(tr), "validate", length(va))
        prep <- fit_prep(d[tr, , drop = FALSE], seed + 100 * k, paste0(label, "_inner", k))
        val <- apply_prep(prep, d[va, , drop = FALSE])$matrices
        for (nm in BASE) for (g in seq_len(nrow(grid[[nm]]))) {
            fits <- fit_ensemble(nm, prep$train, y[tr], grid[[nm]][g, , drop = FALSE], seed + 1000 * k + 100 * g)
            pred[[nm]][va, g] <- predict_ensemble(nm, fits, val, grid[[nm]][g, , drop = FALSE])
        }
    }
    chosen <- list()
    oof <- matrix(NA_real_, length(y), length(BASE), dimnames = list(NULL, BASE))
    scores <- list()
    for (nm in BASE) {
        loss <- apply(pred[[nm]], 2, function(p) ll(y, p))
        best <- which.min(loss)
        chosen[[nm]] <- grid[[nm]][best, , drop = FALSE]
        oof[, nm] <- pred[[nm]][, best]
        scores[[nm]] <- cbind(model = nm, grid[[nm]], logloss = loss, selected = seq_along(loss) == best)
        write_csv(scores[[nm]], paste0(label, "_", nm, "_调参.csv"), DIRS["audit"])
    }
    list(params = chosen, oof = oof, fold = folds)
}
})

