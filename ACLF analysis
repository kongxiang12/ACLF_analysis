paired_net_benefit <- function(y,p,draws,ds) {
  calc <- function(i,t) {
    yy <- y[i]; pp<-p[i,,drop=FALSE]; weight<-t/(1-t)
    nb<-colMeans((pp>=t)*(yy==1L))-weight*colMeans((pp>=t)*(yy==0L))
    all<-mean(yy)-weight*mean(yy==0L)
    c(nb[1]-nb[2],nb[1]-all,nb[2]-all,nb[1],nb[2])
  }
  contrast <- c('ElasticNet minus LightGBM','ElasticNet minus treat all','LightGBM minus treat all','ElasticNet minus treat none','LightGBM minus treat none')
  rb(lapply(seq(.05,.50,.01),function(t){
    d <- vapply(draws,calc,numeric(5L),t=t)
    ci<-t(apply(d,1L,ms_percentile_ci))
    data.frame(dataset=ds,threshold=t,contrast=contrast,delta=unname(calc(seq_along(y),t)),lower=ci[,'lower'],upper=ci[,'upper'])
  }))
}
