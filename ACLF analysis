    jsonlite::write_json(list(main=aclf_definitions(aclf_main_definitions),slim=aclf_definitions(aclf_slim_definitions),
        six=aclf_definitions(aclf_six_definitions),single=aclf_definitions(aclf_single_definitions)),artifact,auto_unbox=TRUE)
    if (mode == "all") {
