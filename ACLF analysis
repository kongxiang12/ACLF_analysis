manuscript_plot_require <- function(d, columns, label = "plot data") {
    if (!is.data.frame(d)) 
        stop(label, " must be a data.frame")
    missing <- setdiff(columns, names(d))
    if (length(missing)) 
        stop(label, " missing columns: ", paste(missing, collapse = ", "))
    if (!nrow(d)) 
