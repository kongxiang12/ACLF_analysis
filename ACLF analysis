summarize_pair <- function(d, ds, model, subgroup = "Overall", bootstrap = NULL) {
    paired <- is.finite(d$singleton)
    a <- d[paired, , drop = FALSE]
    absolute_shift <- abs(a$singleton - a$batch)
    shift <- absolute_shift[a$missing_count > 0L]
    higher <- a$batch < a$threshold & a$singleton >= a$threshold
    lower <- a$batch >= a$threshold & a$singleton < a$threshold
    row <- data.frame(dataset = ds, model = model, subgroup = subgroup, total_n = nrow(d), total_deaths = sum(d$event), scored_n = nrow(a), 
        scored_deaths = sum(a$event), missing_n = sum(d$missing_count > 0L), missing_scored_n = length(shift), median_abs_pp_missing = if (length(shift)) 
            100 * median(shift)
        else NA_real_, p95_abs_pp_missing = if (length(shift)) 
            100 * unname(quantile(shift, 0.95))
        else NA_real_, median_abs_pp_all = 100 * median(absolute_shift), p95_abs_pp_all = 100 * unname(quantile(absolute_shift, 
            0.95)), low_to_high = sum(higher), low_to_high_deaths = sum(a$event[higher]), high_to_low = sum(lower), high_to_low_deaths = sum(a$event[lower]), 
        threshold = unique(d$threshold), fallback_cells = sum(d$fallback, na.rm = TRUE))
    metrics <- c("AUC", "Brier", "calibration_in_the_large", "calibration_slope")
    estimate <- function(i, p) ms_metrics(a$event[i], p[i], row$threshold)[metrics]
    idx <- seq_len(nrow(a))
    point_batch <- estimate(idx, a$batch)
    point_singleton <- estimate(idx, a$singleton)
    draws <- if (!is.null(bootstrap)) {
        stopifnot(all(paired))
        vapply(bootstrap, function(i) estimate(i, a$singleton) - estimate(i, a$batch), setNames(numeric(length(metrics)), 
            metrics))
    }
    else NULL
    for (metric in metrics) {
        row[[paste0(metric, "_batch")]] <- unname(point_batch[metric])
        row[[paste0(metric, "_single")]] <- unname(point_singleton[metric])
        row[[paste0(metric, "_delta")]] <- unname(point_singleton[metric] - point_batch[metric])
        ci <- if (!is.null(draws)) 
            ms_percentile_ci(draws[metric, ])
        else c(lower = NA, upper = NA, valid = NA)
        row[[paste0(metric, "_delta_lower")]] <- unname(ci["lower"])
        row[[paste0(metric, "_delta_upper")]] <- unname(ci["upper"])
        row[[paste0(metric, "_valid")]] <- unname(ci["valid"])
    }
    row
}

