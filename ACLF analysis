}

fit_one <- function(name, x, y, param, seed) {
    set.seed(seed)
    if (name == "ElasticNet") {
        return(glmnet::glmnet(x, y, family = "binomial", alpha = param$alpha, lambda = param$lambda, standardize = FALSE, 
            intercept = TRUE, control = list(thresh = 1e-08, maxit = 1e+05)))
    }
    if (name == "RandomForest") 
        return(ranger::ranger(x = as.data.frame(x), y = factor(y, levels = 0:1), probability = TRUE, num.trees = 400L, mtry = max(1L, 
            round(ncol(x) * param$mtry_fraction)), min.node.size = param$min_node, seed = seed, num.threads = THREADS, importance = "none"))
    if (name == "XGBoost") 
        return(xgboost::xgb.train(params = list(objective = "binary:logistic", eval_metric = "logloss", max_depth = param$max_depth, 
            eta = 0.04, min_child_weight = 10, subsample = 0.8, colsample_bytree = 0.8, lambda = 2, tree_method = "hist", 
            nthread = THREADS, seed = seed), data = xgboost::xgb.DMatrix(x, label = y), nrounds = param$nrounds, verbose = 0))
    if (name == "LightGBM") 
        return(lightgbm::lgb.train(params = list(objective = "binary", metric = "binary_logloss", learning_rate = 0.04, num_leaves = param$num_leaves, 
            max_depth = 4L, min_data_in_leaf = 30L, feature_fraction = 0.8, bagging_fraction = 0.8, bagging_freq = 1L, lambda_l2 = 2, 
            deterministic = TRUE, force_col_wise = TRUE, seed = seed, num_threads = THREADS, verbosity = -1L), data = lightgbm::lgb.Dataset(x, 
            label = y), nrounds = param$nrounds, verbose = -1L, record = FALSE, serializable = TRUE))
    if (name == "CatBoost") {
        pool <- catboost::catboost.load_pool(data = x, label = y)
        model <- catboost::catboost.train(pool, params = list(loss_function = "Logloss", eval_metric = "Logloss", depth = param$depth, 
            iterations = param$iterations, learning_rate = 0.04, l2_leaf_reg = 3, random_seed = seed, thread_count = THREADS, 
            task_type = "CPU", logging_level = "Silent", allow_writing_files = FALSE))
        return(pack_catboost(model))
    }
    if (name == "SVM_RBF") 
        return(kernlab::ksvm(x = x, y = factor(y, levels = 0:1), type = "C-svc", kernel = "rbfdot", kpar = list(sigma = param$sigma_multiplier/ncol(x)), 
            C = param$C, scaled = FALSE, prob.model = TRUE, cross = 0, fit = FALSE, cache = 128))
    stop("Unknown base model: ", name)
}

pred_one <- function(name, fit, x, param) {
    if (name == "ElasticNet") 
        return(as.numeric(predict(fit, newx = x, s = param$lambda, type = "response")))
    if (name == "RandomForest") 
        return(as.numeric(predict(fit, data = as.data.frame(x), num.threads = THREADS)$predictions[, "1"]))
    if (name == "XGBoost") 
        return(as.numeric(predict(fit, xgboost::xgb.DMatrix(x))))
    if (name == "LightGBM") 
        return(as.numeric(predict(fit, x)))
    if (name == "CatBoost") 
        return(as.numeric(catboost::catboost.predict(unpack_catboost(fit), catboost::catboost.load_pool(data = x), prediction_type = "Probability", 
            thread_count = THREADS)))
    if (name == "SVM_RBF") {
        probabilities <- kernlab::predict(fit, x, type = "probabilities")
        stopifnot(is.matrix(probabilities), "1" %in% colnames(probabilities))
        return(as.numeric(probabilities[, "1"]))
    }
    stop("Unknown base model: ", name)
}

fit_ensemble <- function(name, mats, y, param, seed) lapply(seq_len(M), function(j) fit_one(name, mats[[j]], y, param, seed + 
    j))

predict_ensemble <- function(name, fits, mats, param) {
    p <- Reduce("+", lapply(seq_len(M), function(j) pred_one(name, fits[[j]], mats[[j]], param)))/M
    stopifnot(length(p) == nrow(mats[[1]]), all(is.finite(p)), all(p >= 0 & p <= 1))
    clip(p)
}

