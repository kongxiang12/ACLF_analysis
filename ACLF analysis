options(stringsAsFactors = FALSE, warn = 1)
aclf_definitions <- function(block) {
    expressions <- as.list(block)[-1L]
    names(expressions) <- vapply(expressions, function(x) as.character(x[[2L]]), "")
    lapply(expressions, function(x) paste(deparse(x, width.cutoff = 120L), collapse = "\n"))
}
aclf_main_definitions <- quote({
assert <- function(ok, message) if (!isTRUE(ok)) stop(message, call. = FALSE)

rb <- function(xs) {
    xs <- Filter(function(x) is.data.frame(x) && nrow(x) > 0, xs)
    if (!length(xs)) 
        return(data.frame())
    cols <- unique(unlist(lapply(xs, names)))
    xs <- lapply(xs, function(x) {
        for (v in setdiff(cols, names(x))) x[[v]] <- NA
        x[, cols, drop = FALSE]
    })
    z <- do.call(rbind, xs)
    rownames(z) <- NULL
    z
}

logmsg <- function(...) cat(format(Sys.time(), "%Y-%m-%d %H:%M:%S"), ..., "\n")

clip <- function(p) pmin(pmax(as.numeric(p), 1e-06), 1 - 1e-06)

apply_prep <- function(prep, new_df) {
    z <- new_df[, prep$vars, drop = FALSE]
    imp <- prep$mids
    for (v in prep$vars) {
        if (anyNA(z[[v]]) && !nzchar(imp$method[v])) 
            imp$method[v] <- "pmm"
    }
    newimp <- mice::mice.mids(imp, newdata = z, maxit = MAXIT, printFlag = FALSE)
    stopifnot(nrow(newimp$data) == nrow(z), all(newimp$ignore))
    if (nrow(z) == 1L && is.null(dim(newimp$where))) {
        dim(newimp$where) <- dim(z)
        dimnames(newimp$where) <- dimnames(newimp$data)
    }
    comp <- mice::complete(newimp, "all")
    n_fallback <- 0L
    mats <- lapply(comp, function(d) {
        for (v in prep$vars) {
            bad <- !is.finite(d[[v]])
            n_fallback <<- n_fallback + sum(bad)
            d[[v]][bad] <- prep$med[v]
            if (v %in% TRANSFORM_LOG) 
                d[[v]] <- log1p(pmax(d[[v]], 0))
        }
        x <- as.matrix(d[, prep$vars, drop = FALSE])
        sweep(sweep(x, 2, prep$center, "-"), 2, prep$scale, "/")
    })
    if (n_fallback) 
        logmsg("new-data MICE residual missing fallback cells:", n_fallback)
    list(matrices = mats, completed = comp, fallback_cells = n_fallback)
}

predict_ensemble <- function(name, fits, mats, param) {
    p <- Reduce("+", lapply(seq_len(M), function(j) pred_one(name, fits[[j]], mats[[j]], param)))/M
    stopifnot(length(p) == nrow(mats[[1]]), all(is.finite(p)), all(p >= 0 & p <= 1))
    clip(p)
}

predict_slim_locked <- function(lock, new_df) {
    p <- do.call(cbind, lapply(lock$models, function(z) {
        stopifnot(identical(z$prep$vars, colnames(z$prep$mids$data)), length(z$prep$vars) == z$k)
        val <- apply_prep(z$prep, new_df[, z$prep$vars, drop = FALSE])
        predict_ensemble(z$family, z$fits, val$matrices, z$param)
    }))
    p[, MODEL_NAMES, drop = FALSE]
}

`%||%` <- function(x, y) if (is.null(x) || !length(x)) y else x

matched_discrimination <- function(cohorts) {
    results <- lapply(names(cohorts), function(dataset) {
        cohort <- cohorts[[dataset]]
        observed <- as.matrix(cohort$x[, BENCHMARK_INPUTS, drop = FALSE])
        storage.mode(observed) <- "double"
        keep <- which(rowSums(!is.finite(observed)) == 0L)
        y <- cohort$y[keep]
        assert(length(keep) > 20 && length(unique(y)) == 2L, "Insufficient matched ROC patients.")
        scores <- cbind(cohort$p[keep, MODELS, drop = FALSE],
                        benchmark_scores(cohort$x[keep, , drop = FALSE]))
        lapply(colnames(scores), function(model) {
            roc <- pROC::roc(y, scores[, model], levels = c(0, 1), direction = "<", quiet = TRUE)
            ci <- as.numeric(pROC::ci.auc(roc, method = "delong"))
            list(
                roc = data.frame(dataset, model, FPR = 1 - roc$specificities, TPR = roc$sensitivities),
                metrics = data.frame(dataset, model, n = length(keep), events = sum(y),
                                     AUC = as.numeric(pROC::auc(roc)),
                                     AUC_lower = ci[1L], AUC_upper = ci[3L])
            )
        })
    })
    rows <- unlist(results, recursive = FALSE)
    list(roc = rb(lapply(rows, "[[", "roc")), metrics = rb(lapply(rows, "[[", "metrics")))
}

manuscript_variable_table <- function(inp, labels, units) {
    vars <- inp$required
    out <- data.frame(
        variable = vars, label = unname(labels[vars]), unit = unname(units[vars]),
        ElasticNet = vars %in% inp$lock$models[["ElasticNet_Reduced"]]$prep$vars,
        LightGBM = vars %in% inp$lock$models[["LightGBM_Reduced"]]$prep$vars,
        check.names = FALSE
    )
    for (dataset in names(inp$cohorts)) {
        values <- inp$cohorts[[dataset]]$x[, vars, drop = FALSE]
        out[[paste0("missing_", dataset)]] <- vapply(values, function(x) mean(is.na(x)), 0)
    }
    out
}

manuscript_baseline_details <- function(inp) {
    historical <- inp$reporting$profile
    meta <- inp$variables
    full <- inp$lock$models$ElasticNet_Full$prep$vars
    assert(length(full) == 27L && nrow(historical) == 43L, "Unexpected candidate reporting scope.")
    english <- c(age = "Age", gender_male = "Male", gcs = "Assessable GCS", circ_of = "Circulatory failure proxy", resp_of = "Respiratory failure proxy", 
        lab_albumin = "Albumin", lab_alkaline_phosphatase = "Alkaline phosphatase", lab_alt = "ALT", lab_ast = "AST", lab_ammonia = "Ammonia", 
        lab_basophils = "Basophils", lab_bicarbonate = "Bicarbonate", lab_bilirubin_total = "Total bilirubin", lab_bun = "BUN", 
        lab_calcium_total = "Total calcium", lab_chloride = "Chloride", lab_creatinine = "Creatinine", lab_eosinophils = "Eosinophils", 
        lab_glucose = "Glucose", lab_hematocrit = "Hematocrit", lab_hemoglobin = "Hemoglobin", lab_inr = "INR", lab_lactate = "Lactate", 
        lab_lymphocytes = "Lymphocytes", lab_magnesium = "Magnesium", lab_mch = "MCH", lab_mchc = "MCHC", lab_mcv = "MCV", 
        lab_monocytes = "Monocytes", lab_neutrophils = "Neutrophils", lab_pco2 = "PCO2", lab_ph = "pH", lab_phosphate = "Phosphate", 
        lab_platelet_count = "Platelets", lab_po2 = "PO2", lab_potassium = "Potassium", lab_pt = "Prothrombin time", lab_ptt = "aPTT", 
        lab_rdw = "RDW", lab_red_blood_cells = "Red blood cell count", lab_sodium = "Sodium", lab_total_protein = "Total protein", 
        lab_wbc = "WBC")
    units <- setNames(meta$unit, meta$variable)
    units <- units[!duplicated(names(units))]
    units[c("lab_bicarbonate", "lab_sodium", "lab_potassium", "lab_chloride")] <- "mmol/L"
    units["lab_wbc"] <- "×10⁹/L"
    extra_units <- c(gcs = "score", circ_of = "0/1", resp_of = "0/1", lab_ammonia = "umol/L", lab_basophils = "%", lab_eosinophils = "%", 
        lab_lactate = "mmol/L", lab_lymphocytes = "%", lab_monocytes = "%", lab_neutrophils = "%", lab_pco2 = "mmHg", lab_ph = "unitless", 
        lab_phosphate = "mg/dL", lab_po2 = "mmHg", lab_ptt = "s", lab_total_protein = "g/dL")
    units <- c(units, extra_units[!names(extra_units) %in% names(units)])
    units["age"] <- "years"
    units["lab_inr"] <- "unitless"
    units["lab_ammonia"] <- "unit not verified"
    assert(all(historical$variable %in% names(english)) && all(historical$variable %in% names(units)), "Candidate labels/units incomplete.")
    count_in_china <- c("lab_basophils", "lab_eosinophils", "lab_lymphocytes", "lab_monocytes", "lab_neutrophils")
    binary <- c("gender_male", "circ_of", "resp_of", "hospital_mortality")
    co <- inp$cohorts
    co[["eICU external"]]$x$lab_ammonia <- inp$reporting$ammonia_eicu
    for (ds in names(co)) {
        x <- co[[ds]]$x
        if (!"gender_male" %in% names(x) && "gender" %in% names(x)) {
            z <- tolower(trimws(as.character(x$gender)))
            x$gender_male <- ifelse(z %in% c("male", "m", "男"), 1, ifelse(z %in% c("female", "f", "女"), 0, NA_real_))
        }
        for (v in historical$variable) if (!v %in% names(x)) 
            x[[v]] <- NA_real_
        if (ds == "China external") {
            rbc <- suppressWarnings(as.numeric(x$lab_red_blood_cells))
            bad <- is.finite(rbc) & (rbc <= 0 | rbc > 20)
            assert(sum(bad) == 5L, "Chinese RBC reporting quality flag changed; verify before summarizing.")
            x$lab_red_blood_cells[bad] <- NA_real_
        }
        co[[ds]]$x <- x
    }
    get_value <- function(ds, v) {
        if (v == "hospital_mortality") 
            return(co[[ds]]$y)
        z <- co[[ds]]$x[[v]]
        txt <- as.character(z)
        txt[tolower(txt) == "true"] <- "1"
        txt[tolower(txt) == "false"] <- "0"
        ans <- suppressWarnings(as.numeric(txt))
        ans[!is.finite(ans)] <- NA_real_
        ans
    }
    mean_sd <- c("age", "lab_bicarbonate", "lab_calcium_total", "lab_chloride", "lab_hematocrit", "lab_hemoglobin", "lab_mch", 
        "lab_mcv", "lab_red_blood_cells", "lab_sodium")
    format_value <- function(z, v) {
        a <- z[is.finite(z)]
        if (!length(a)) 
            return("Not recorded")
        if (v %in% binary) 
            sprintf("%d (%.1f%%)", sum(a == 1), 100 * mean(a == 1))
        else if (v %in% mean_sd) {
            sprintf("%.2f (%.2f)", mean(a), stats::sd(a))
        }
        else {
            q <- quantile(a, c(0.5, 0.25, 0.75), names = FALSE)
            sprintf("%.2f (%.2f, %.2f)", q[1], q[2], q[3])
        }
    }
    compare_cohorts <- function(v) {
        result <- list(P_overall = NA_real_, P_display = "", comparison_test = "", comparison_note = "")
        if (v %in% count_in_china) {
            result$comparison_note <- "Not tested: units differ or could not be verified across all three cohorts."
            return(result)
        }
        z <- lapply(DATASETS, function(ds) {
            x <- get_value(ds, v)
            x[is.finite(x)]
        })
        if (any(lengths(z) < 2L)) {
            result$comparison_note <- "Not tested: fewer than two observed values in at least one cohort."
            return(result)
        }
        d <- data.frame(value = unlist(z, use.names = FALSE), group = factor(rep(DATASETS, lengths(z)), levels = DATASETS))
        if (v %in% binary) {
            tab <- table(d$group, factor(d$value, levels = c(0, 1)))
            if (any(colSums(tab) == 0)) {
                result$comparison_note <- "Not tested: no outcome/category variation."
                return(result)
            }
            chi <- suppressWarnings(stats::chisq.test(tab, correct = FALSE))
            if (any(chi$expected < 5)) {
                test <- stats::fisher.test(tab)
                result$comparison_test <- "Fisher exact test"
            }
            else {
                test <- chi
                result$comparison_test <- "Pearson chi-squared test"
            }
        }
        else if (v %in% mean_sd) {
            test <- stats::oneway.test(value ~ group, data = d, var.equal = FALSE)
            result$comparison_test <- "Welch one-way ANOVA"
        }
        else {
            test <- stats::kruskal.test(value ~ group, data = d)
            result$comparison_test <- "Kruskal-Wallis test"
        }
        result$P_overall <- unname(test$p.value)
        result$P_display <- if (result$P_overall < 0.001) 
            "<0.001"
        else sprintf("%.3f", result$P_overall)
        result$comparison_note <- "Exploratory overall three-cohort comparison; unadjusted for multiplicity; observed values only."
        result
    }
    smd <- function(a, b, v) {
        a <- a[is.finite(a)]
        b <- b[is.finite(b)]
        if (min(length(a), length(b)) < 2) 
            return(NA_real_)
        va <- if (v %in% binary) 
            mean(a) * (1 - mean(a))
        else var(a)
        vb <- if (v %in% binary) 
            mean(b) * (1 - mean(b))
        else var(b)
        den <- sqrt((va + vb)/2)
        if (!is.finite(den) || den == 0) 
            return(if (mean(a) == mean(b)) 0 else NA_real_)
        abs(mean(a) - mean(b))/den
    }
    all <- do.call(rbind, lapply(historical$variable, function(v) {
        z <- lapply(DATASETS, get_value, v = v)
        names(z) <- DATASETS
        unit <- if (v == "lab_ammonia") 
            "µmol/L"
        else unname(units[v])
        row <- data.frame(variable = v, label = unname(english[v]), unit = unit, check.names = FALSE)
        for (ds in DATASETS) {
            row[[ds]] <- format_value(z[[ds]], v)
            row[[paste0("missing_", ds)]] <- sum(is.na(z[[ds]]))
            row[[paste0("n_", ds)]] <- length(z[[ds]])
            row[[paste0("unit_", ds)]] <- if (ds == "China external" && v %in% count_in_china) 
                "10^9/L"
            else unit
        }
        row$SMD_eICU_vs_MIMIC <- smd(z[[1]], z[[2]], v)
        row$SMD_China_vs_MIMIC <- if (v %in% count_in_china) 
            NA_real_
        else smd(z[[1]], z[[3]], v)
        row$China_unit_comparable <- !v %in% count_in_china
        row$eICU_unit_comparable <- TRUE
        row$summary_type <- if (v %in% binary) 
            "n (%)"
        else if (v %in% mean_sd) 
            "mean (SD)"
        else "median (P25, P75)"
        comparison <- compare_cohorts(v)
        for (nm in names(comparison)) row[[nm]] <- comparison[[nm]]
        row
    }))
    screen <- historical
    screen$label <- unname(english[screen$variable])
    screen$unit <- unname(units[screen$variable])
    screen$full_model <- screen$variable %in% full
    screen$ElasticNet_reduced <- screen$variable %in% inp$lock$models$ElasticNet_Reduced$prep$vars
    screen$LightGBM_reduced <- screen$variable %in% inp$lock$models$LightGBM_Reduced$prep$vars
    screen$decision <- ifelse(screen$full_model, "Retained for full model", ifelse(!screen$full_development_missing_le_50pct & 
        !screen$external_missing_le_50pct, "Missing >50% in both US cohorts", ifelse(!screen$full_development_missing_le_50pct, 
        "Missing >50% in MIMIC", "Missing >50% in original eICU")))
    screen$historical_eICU_missing <- screen$eICU_missing
    screen$MIMIC_n <- length(inp$mimic_development$y)
    screen$eICU_n <- all[["n_eICU external"]]
    screen$eICU_missing <- all[["missing_eICU external"]]/screen$eICU_n
    stopifnot(sum(screen$full_model) == 27L, sum(screen$ElasticNet_reduced) == 10L, sum(screen$LightGBM_reduced) == 8L)
    primary <- c("hospital_mortality", full)
    baseline <- data.frame(variable = c("Participants", "In-hospital deaths", unname(english[full])), unit = c("n", "n (%)", 
        unname(units[full])), check.names = FALSE)
    for (ds in DATASETS) baseline[[ds]] <- c(as.character(length(co[[ds]]$y)), vapply(primary, function(v) format_value(get_value(ds, 
        v), v), ""))
    for (pair in list(c("eICU external", "SMD_eICU_vs_MIMIC"), c("China external", "SMD_China_vs_MIMIC"))) {
        baseline[[pair[2]]] <- c(NA_real_, vapply(primary, function(v) smd(get_value(DATASETS[1], v), get_value(pair[1], 
            v), v), 0))
    }
    comparison <- lapply(primary, compare_cohorts)
    baseline$summary_type <- c("n", vapply(primary, function(v) if (v %in% binary) "n (%)" else if (v %in% mean_sd) "mean (SD)" else "median (P25, P75)", 
        ""))
    for (nm in names(comparison[[1]])) baseline[[nm]] <- c(if (nm == "P_overall") NA_real_ else "", vapply(comparison, function(r) r[[nm]], 
        if (nm == "P_overall") 0 else ""))
    list(primary = baseline, all = all, screen = screen, full_variables = full)
}

benchmark_scores <- function(x) {
    cr <- pmin(pmax(x$lab_creatinine, 1), 4)
    bi <- pmax(x$lab_bilirubin_total, 1)
    ir <- pmax(x$lab_inr, 1)
    meld <- pmin(pmax(round(3.78 * log(bi) + 11.2 * log(ir) + 9.57 * log(cr) + 6.43), 6), 40)
    na <- pmin(pmax(x$lab_sodium, 125), 137)
    cbind(MELD_lab = meld, MELDNa_lab = pmin(pmax(round(meld + 1.32 * (137 - na) - 0.033 * meld * (137 - na)), 6), 40))
}

fit_benchmark <- function(d, y, seed) {
    vars <- BENCHMARK_INPUTS
    d <- d[, vars, drop = FALSE]
    med <- vapply(d, median, na.rm = TRUE, FUN.VALUE = 0)
    assert(all(is.finite(med)), "Comparator training has a wholly missing variable.")
    init <- d
    for (v in vars) init[[v]][is.na(init[[v]])] <- med[v]
    meth <- setNames(rep("pmm", length(vars)), vars)
    meth[vapply(d, function(x) !anyNA(x), TRUE)] <- ""
    imp <- mice::mice(d, m = 5, maxit = 5, method = meth, data.init = init, printFlag = FALSE, seed = seed, remove.collinear = FALSE, 
        remove.constant = FALSE)
    completed <- mice::complete(imp, "all")
    fits <- lapply(completed, function(z) {
        a <- benchmark_scores(z)
        lapply(seq_len(ncol(a)), function(k) stats::glm(y ~ score, data = data.frame(y = y, score = a[, k]), family = binomial()))
    })
    fits
}

ms_check <- function(y, p = NULL) {
    if (!is.numeric(y) || !length(y) || anyNA(y) || any(!y %in% c(0, 1))) 
        stop("Outcome must be a non-missing numeric vector containing only 0 and 1.")
    if (!is.null(p) && (!is.numeric(p) || length(p) != length(y) || any(!is.finite(p)) || any(p < 0 | p > 1))) 
        stop("Predictions must be finite probabilities in [0,1], one per outcome.")
    invisible(TRUE)
}

ms_clip <- function(p, eps = 1e-06) pmin(pmax(as.numeric(p), eps), 1 - eps)

ms_auc_rank <- function(y, p) {
    ms_check(y, p)
    n1 <- sum(y == 1)
    n0 <- sum(y == 0)
    if (!n1 || !n0) 
        return(NA_real_)
    (sum(rank(p, ties.method = "average")[y == 1]) - n1 * (n1 + 1)/2)/(n1 * n0)
}

ms_auc_delong <- function(y, p, confidence = 0.95) {
    ms_check(y, p)
    result <- c(AUC = ms_auc_rank(y, p), lower = NA_real_, upper = NA_real_)
    if (min(sum(y == 1), sum(y == 0)) < 2) 
        return(result)
    ro <- pROC::roc(y, p, levels = c(0, 1), direction = "<", quiet = TRUE)
    ci <- tryCatch(suppressWarnings(as.numeric(pROC::ci.auc(ro, conf.level = confidence, method = "delong"))), error = function(e) rep(NA_real_, 
        3))
    result[c("lower", "upper")] <- ci[c(1, 3)]
    result
}

ms_glm_coefficients <- function(x, y) {
    warnings <- character()
    fit <- tryCatch(withCallingHandlers(stats::glm.fit(x = x, y = y, family = stats::binomial(), control = stats::glm.control(maxit = 100)), 
        warning = function(w) {
            warnings <<- c(warnings, conditionMessage(w))
            invokeRestart("muffleWarning")
        }), error = function(e) NULL)
    if (is.null(fit)) 
        return(list(coef = NULL, status = "fit_failed"))
    if (!isTRUE(fit$converged) || fit$rank < ncol(x) || any(!is.finite(fit$coefficients))) 
        return(list(coef = NULL, status = "nonconvergent_or_singular"))
    if (any(grepl("numerically 0 or 1|did not converge", warnings, fixed = FALSE))) 
        return(list(coef = NULL, status = "separation_or_nonconvergence"))
    list(coef = unname(fit$coefficients), status = "ok")
}

ms_calibration <- function(y, p, min_events = 5L, eps = 1e-06) {
    ms_check(y, p)
    result <- c(calibration_in_the_large = NA_real_, calibration_intercept = NA_real_, calibration_slope = NA_real_)
    if (min(sum(y == 1), sum(y == 0)) < min_events) 
        return(list(estimates = result, status = "insufficient_events_or_nonevents"))
    lp <- stats::qlogis(ms_clip(p, eps))
    citl <- tryCatch(stats::uniroot(function(a) mean(stats::plogis(a + lp)) - mean(y), interval = c(-80, 80), tol = 1e-10)$root, 
        error = function(e) NA_real_)
    result["calibration_in_the_large"] <- citl
    if (length(unique(lp)) < 3L) 
        return(list(estimates = result, status = "insufficient_prediction_variation"))
    fit <- ms_glm_coefficients(cbind(1, lp), y)
    if (!is.null(fit$coef)) 
        result[c("calibration_intercept", "calibration_slope")] <- fit$coef
    list(estimates = result, status = fit$status)
}

ms_metrics <- function(y, p, threshold, min_calibration_events = 5L) {
    ms_check(y, p)
    if (length(threshold) != 1L || !is.finite(threshold) || threshold <= 0 || threshold >= 1) 
        stop("Provide a single, previously locked probability cutoff strictly between 0 and 1.")
    positive <- p >= threshold
    n1 <- sum(y == 1)
    n0 <- sum(y == 0)
    sensitivity <- if (n1) 
        sum(positive & y == 1)/n1
    else NA_real_
    specificity <- if (n0) 
        sum(!positive & y == 0)/n0
    else NA_real_
    cal <- ms_calibration(y, p, min_events = min_calibration_events)
    ans <- c(AUC = ms_auc_rank(y, p), Brier = mean((y - p)^2), LogLoss = -mean(y * log(ms_clip(p)) + (1 - y) * log1p(-ms_clip(p))), 
        cal$estimates, sensitivity = sensitivity, specificity = specificity, PPV = if (any(positive)) mean(y[positive]) else NA_real_, 
        NPV = if (any(!positive)) mean(1 - y[!positive]) else NA_real_, accuracy = mean(positive == y), Youden = sensitivity + 
            specificity - 1, high_risk_fraction = mean(positive))
    attr(ans, "calibration_status") <- cal$status
    ans
}

ms_bootstrap_plan <- function(y, B = 500L, seed = 20261102L, cluster = NULL) {
    ms_check(y)
    B <- as.integer(B)
    if (!is.finite(B) || B < 0L) 
        stop("B must be a non-negative integer.")
    if (!is.null(cluster) && (length(cluster) != length(y) || anyNA(cluster))) 
        stop("A non-missing cluster identifier is required for every patient.")
    set.seed(seed)
    if (is.null(cluster)) {
        plan <- lapply(seq_len(B), function(b) sample.int(length(y), length(y), replace = TRUE))
        attr(plan, "sampling") <- "ordinary_patient_bootstrap"
    }
    else {
        groups <- split(seq_along(y), as.character(cluster), drop = TRUE)
        if (length(groups) < 2L) 
            stop("Cluster bootstrap requires at least two clusters.")
        plan <- lapply(seq_len(B), function(b) unlist(groups[sample.int(length(groups), length(groups), replace = TRUE)], 
            use.names = FALSE))
        attr(plan, "sampling") <- "hospital_cluster_bootstrap"
    }
    plan
}

ms_percentile_ci <- function(z, confidence = 0.95, minimum_valid = 30L) {
    z <- z[is.finite(z)]
    nvalid <- length(z)
    if (nvalid < minimum_valid) 
        return(c(lower = NA_real_, upper = NA_real_, valid = nvalid))
    q <- stats::quantile(z, c((1 - confidence)/2, (1 + confidence)/2), names = FALSE)
    c(lower = q[1], upper = q[2], valid = nvalid)
}

ms_roc_data <- function(y, p, dataset, model) {
    ms_check(y, p)
    if (length(unique(y)) < 2L) 
        return(data.frame(dataset = character(), model = character(), threshold = numeric(), FPR = numeric(), TPR = numeric()))
    ro <- pROC::roc(y, p, levels = c(0, 1), direction = "<", quiet = TRUE)
    data.frame(dataset = dataset, model = model, threshold = ro$thresholds, FPR = 1 - ro$specificities, TPR = ro$sensitivities, 
        check.names = FALSE)
}

ms_risk_data <- function(y, p, dataset, model) {
    ms_check(y, p)
    data.frame(dataset = dataset, model = model, event = y, probability = as.numeric(p), check.names = FALSE)
}

ms_evaluate_models <- function(y, predictions, thresholds, dataset, prediction_kind = c("external", "OOF"), B = 500L, seed = 20261102L, 
    cluster = NULL, boot_indices = NULL, confidence = 0.95, minimum_valid = 30L, return_draws = FALSE, auc_ci_method = c("auto", 
        "delong", "bootstrap")) {
    prediction_kind <- match.arg(prediction_kind)
    auc_ci_method <- match.arg(auc_ci_method)
    predictions <- as.matrix(predictions)
    if (is.null(colnames(predictions)) || anyDuplicated(colnames(predictions))) 
        stop("Predictions need unique model column names.")
    models <- colnames(predictions)
    if (!all(models %in% names(thresholds))) 
        stop("A locked threshold is required for each model.")
    for (model in models) ms_check(y, predictions[, model])
    if (is.null(boot_indices)) 
        boot_indices <- ms_bootstrap_plan(y, B, seed, cluster)
    cluster_sampling <- !is.null(cluster) || identical(attr(boot_indices, "sampling"), "hospital_cluster_bootstrap")
    selected_auc_ci <- if (auc_ci_method == "auto") {
        if (cluster_sampling) 
            "bootstrap"
        else "delong"
    }
    else auc_ci_method
    if (any(vapply(boot_indices, function(i) !length(i) || anyNA(i) || any(i < 1 | i > length(y)), TRUE))) 
        stop("Invalid bootstrap indices.")
    point <- lapply(models, function(model) ms_metrics(y, predictions[, model], thresholds[model]))
    names(point) <- models
    metric_names <- names(point[[1]])
    draws <- array(NA_real_, dim = c(length(boot_indices), length(models), length(metric_names)), dimnames = list(NULL, models, 
        metric_names))
    for (b in seq_along(boot_indices)) {
        i <- boot_indices[[b]]
        for (model in models) draws[b, model, ] <- ms_metrics(y[i], predictions[i, model], thresholds[model])
    }
    inference_note <- if (prediction_kind == "OOF") 
        paste("固定外层OOF预测的描述性评价；置信区间未包含重新建模变异。", "全开发内层OOF锁定截点应用于外层OOF，分类表现不是独立外层阈值评估。")
    else "外部固定模型及预先锁定截点评价；bootstrap不重新训练模型或调整截点。"
    intervals <- list()
    summary_rows <- list()
    q <- 1L
    for (model in models) {
        estimates <- point[[model]]
        cis <- lapply(metric_names, function(metric) ms_percentile_ci(draws[, model, metric], confidence, minimum_valid))
        names(cis) <- metric_names
        auc_ci <- ms_auc_delong(y, predictions[, model], confidence)
        main_auc_ci <- if (selected_auc_ci == "delong") 
            auc_ci
        else cis[["AUC"]]
        extra <- c(AUC_lower = main_auc_ci["lower"], AUC_upper = main_auc_ci["upper"], AUC_DeLong_lower = auc_ci["lower"], 
            AUC_DeLong_upper = auc_ci["upper"])
        names(extra) <- c("AUC_lower", "AUC_upper", "AUC_DeLong_lower", "AUC_DeLong_upper")
        for (metric in setdiff(metric_names, "AUC")) {
            extra[paste0(metric, "_lower")] <- cis[[metric]]["lower"]
            extra[paste0(metric, "_upper")] <- cis[[metric]]["upper"]
        }
        summary_rows[[model]] <- cbind(data.frame(dataset = dataset, model = model, n = length(y), events = sum(y), nonevents = sum(y == 
            0), prediction_kind = prediction_kind, threshold = unname(thresholds[model]), AUC_CI_method = if (selected_auc_ci == 
            "delong") 
            "DeLong"
        else (attr(boot_indices, "sampling") %||% "supplied_bootstrap_indices"), calibration_status = attr(estimates, "calibration_status"), 
            inference_note = inference_note, check.names = FALSE), as.data.frame(as.list(c(estimates, extra)), check.names = FALSE))
        for (metric in metric_names) {
            ci <- cis[[metric]]
            intervals[[q]] <- data.frame(dataset = dataset, model = model, metric = metric, estimate = unname(estimates[metric]), 
                lower = ci["lower"], upper = ci["upper"], valid_replicates = as.integer(ci["valid"]), attempted_replicates = length(boot_indices), 
                method = attr(boot_indices, "sampling") %||% "supplied_bootstrap_indices", inference_note = inference_note, 
                row.names = NULL, check.names = FALSE)
            q <- q + 1L
        }
    }
    comparisons <- list()
    q <- 1L
    if (length(models) >= 2L) 
        for (pair in utils::combn(models, 2, simplify = FALSE)) {
            delong_p <- NA_real_
            if (prediction_kind == "external" && !cluster_sampling && length(unique(y)) == 2L) {
                delong_p <- tryCatch(suppressWarnings(pROC::roc.test(pROC::roc(y, predictions[, pair[1]], levels = c(0, 1), 
                  direction = "<", quiet = TRUE), pROC::roc(y, predictions[, pair[2]], levels = c(0, 1), direction = "<", 
                  quiet = TRUE), paired = TRUE, method = "delong")$p.value), error = function(e) NA_real_)
                if (!is.finite(delong_p)) 
                  delong_p <- NA_real_
            }
            for (metric in c("AUC", "Brier", "LogLoss")) {
                ci <- ms_percentile_ci(draws[, pair[1], metric] - draws[, pair[2], metric], confidence, minimum_valid)
                comparisons[[q]] <- data.frame(dataset = dataset, model_a = pair[1], model_b = pair[2], metric = metric, 
                  difference = unname(point[[pair[1]]][metric] - point[[pair[2]]][metric]), lower = ci["lower"], upper = ci["upper"], 
                  valid_replicates = as.integer(ci["valid"]), p_value = if (metric == "AUC") 
                    delong_p
                  else NA_real_, p_value_method = if (metric == "AUC" && prediction_kind == "external" && !cluster_sampling) 
                    "paired_DeLong_fixed_external_predictions"
                  else if (cluster_sampling) 
                    "paired_cluster_bootstrap_CI_only"
                  else "not_tested", inference_note = inference_note, row.names = NULL, check.names = FALSE)
                q <- q + 1L
            }
        }
    result <- list(summary = do.call(rbind, summary_rows), intervals = do.call(rbind, intervals), comparisons = if (length(comparisons)) do.call(rbind, 
        comparisons) else data.frame(), roc = do.call(rbind, lapply(models, function(model) ms_roc_data(y, predictions[, 
        model], dataset, model))), risk = do.call(rbind, lapply(models, function(model) ms_risk_data(y, predictions[, model], 
        dataset, model))), bootstrap_indices = boot_indices, inference_note = inference_note)
    rownames(result$summary) <- NULL
    if (return_draws) 
        result$bootstrap_draws <- draws
    result
}

ms_calibration_curve <- function(y, p, dataset, model, B = 500L, seed = 20261102L, cluster = NULL, boot_indices = NULL, confidence = 0.95, 
    grid_length = 100L, spline_df = 3L, min_events = 10L, minimum_valid = 30L) {
    ms_check(y, p)
    empty <- data.frame(dataset = character(), model = character(), predicted = numeric(), observed = numeric(), lower = numeric(), 
        upper = numeric(), valid_replicates = integer(), status = character(), stringsAsFactors = FALSE)
    if (min(sum(y == 1), sum(y == 0)) < min_events || length(unique(p)) < spline_df + 2L) {
        attr(empty, "status") <- "insufficient_events_or_prediction_variation"
        return(empty)
    }
    lp <- stats::qlogis(ms_clip(p))
    grid <- seq(min(p), max(p), length.out = grid_length)
    basis <- tryCatch(splines::ns(lp, df = spline_df), error = function(e) NULL)
    if (is.null(basis)) {
        attr(empty, "status") <- "spline_basis_failed"
        return(empty)
    }
    design <- cbind(1, basis)
    grid_design <- cbind(1, predict(basis, stats::qlogis(ms_clip(grid))))
    fit <- ms_glm_coefficients(design, y)
    if (is.null(fit$coef)) {
        attr(empty, "status") <- fit$status
        return(empty)
    }
    observed <- stats::plogis(drop(grid_design %*% fit$coef))
    if (is.null(boot_indices)) 
        boot_indices <- ms_bootstrap_plan(y, B, seed, cluster)
    curve_draws <- matrix(NA_real_, nrow = length(boot_indices), ncol = length(grid))
    for (b in seq_along(boot_indices)) {
        i <- boot_indices[[b]]
        if (min(sum(y[i] == 1), sum(y[i] == 0)) < min_events) 
            next
        fb <- ms_glm_coefficients(design[i, , drop = FALSE], y[i])
        if (!is.null(fb$coef)) 
            curve_draws[b, ] <- stats::plogis(drop(grid_design %*% fb$coef))
    }
    ci <- vapply(seq_along(grid), function(j) ms_percentile_ci(curve_draws[, j], confidence, minimum_valid), numeric(3))
    ans <- data.frame(dataset = dataset, model = model, predicted = grid, observed = observed, lower = ci["lower", ], upper = ci["upper", 
        ], valid_replicates = as.integer(ci["valid", ]), status = "logistic_natural_spline_assessment_only", row.names = NULL, 
        check.names = FALSE)
    attr(ans, "status") <- "ok"
    attr(ans, "note") <- paste("校准评估曲线，不替换原模型概率；自然样条仅用于作图。", "曲线限于原预测范围，bootstrap采用固定样条结点。")
    ans
}

ms_dca_models <- function(y, predictions, dataset, thresholds = seq(0.05, 0.5, 0.01), B = 500L, seed = 20261102L, cluster = NULL, 
    boot_indices = NULL, confidence = 0.95, minimum_valid = 30L) {
    predictions <- as.matrix(predictions)
    models <- colnames(predictions)
    if (is.null(models)) 
        stop("DCA predictions require model names.")
    for (model in models) ms_check(y, predictions[, model])
    if (!length(thresholds) || any(!is.finite(thresholds)) || any(thresholds <= 0 | thresholds >= 1)) 
        stop("DCA thresholds must be probabilities strictly between zero and one.")
    thresholds <- sort(unique(thresholds))
    compute <- function(yy, pp) {
        z <- vapply(models, function(model) vapply(thresholds, function(t) {
            high <- pp[, model] >= t
            mean(high & yy == 1) - mean(high & yy == 0) * t/(1 - t)
        }, 0), numeric(length(thresholds)))
        z <- matrix(z, nrow = length(thresholds), ncol = length(models), dimnames = list(NULL, models))
        z <- cbind(z, Treat_all = mean(yy) - (1 - mean(yy)) * thresholds/(1 - thresholds), Treat_none = 0)
        z
    }
    point <- compute(y, predictions)
    if (is.null(boot_indices)) 
        boot_indices <- ms_bootstrap_plan(y, B, seed, cluster)
    draws <- array(NA_real_, c(length(boot_indices), length(thresholds), ncol(point)))
    for (b in seq_along(boot_indices)) {
        i <- boot_indices[[b]]
        draws[b, , ] <- compute(y[i], predictions[i, , drop = FALSE])
    }
    result <- lapply(seq_len(ncol(point)), function(j) {
        ci <- vapply(seq_along(thresholds), function(k) ms_percentile_ci(draws[, k, j], confidence, minimum_valid), numeric(3))
        data.frame(dataset = dataset, model = colnames(point)[j], threshold = thresholds, net_benefit = point[, j], lower = ci["lower", 
            ], upper = ci["upper", ], valid_replicates = as.integer(ci["valid", ]), row.names = NULL, check.names = FALSE)
    })
    ans <- do.call(rbind, result)
    rownames(ans) <- NULL
    attr(ans, "note") <- "所评估阈值范围内的回顾性净获益评估，不证明实施模型能够改善死亡结局。"
    ans
}

