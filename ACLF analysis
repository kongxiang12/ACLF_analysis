    tune<-e$inner_slim(train$x[tr,,drop=FALSE],train$y[tr],seed+10000L*j,label)
    fit<-e$fit_partition(train$x[tr,,drop=FALSE],train$y[tr],tune,seed+20000L*j,seed+30000L*j,
                          seed+3000000L+10000L*j,label,train$x[va,,drop=FALSE])
    result<-list(index=va,predictions=fit$pred,choices=tune$choices,scores=tune$scores,vars=lapply(fit$models,function(m)m$prep$vars))
  } else {
    tune<-e$inner_slim(train$x,train$y,seed+600000L,'full')
    fit<-e$fit_partition(train$x,train$y,tune,seed+700000L,seed+800000L,seed+4000000L,'full')
    thresholds <- setNames(vapply(e$MODEL_NAMES,function(nm){
      family<-sub('_(Full|Reduced)$','',nm); choice<-tune$choices[[family]][[if(grepl('_Full$',nm)) 'full' else 'reduced']]
      p<-tune$predictions[[family]][[choice$budget_key]][,choice$grid_id]
      as.numeric(pROC::coords(pROC::roc(train$y,p,levels=c(0,1),direction='<',quiet=TRUE),'best',best.method='youden',ret='threshold',transpose=FALSE)[1,1])
    },0.),e$MODEL_NAMES)
    result <- list(lock=list(models=fit$models,threshold=thresholds,seed=seed,M=5L,maxit=5L,candidates=train$candidates,
      fingerprint=e$FINGERPRINT),scores=tune$scores,choices=tune$choices)
  }
  result$fingerprint<-e$FINGERPRINT
  saveRDS(result,file);cat('Complete\n');TRUE
}
