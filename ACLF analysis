        quit(save = "no", status = if (length(args) && args[1L] %in% c("-h", "--help")) 0 else 2)
    }
    mode <- match.arg(args[1L], c("six","reduce","evaluate","singleton","all"))
    aclf_script_path <- normalizePath(sub("^--file=", "", grep("^--file=", commandArgs(FALSE), value=TRUE)[1]), winslash="/")
    input <- normalizePath(args[2L], winslash="/", mustWork=TRUE)
