    dir.create(dirname(path_stub), recursive = TRUE, showWarnings = FALSE)
    png_path <- paste0(path_stub, ".png")
    ggplot2::ggsave(png_path, plot = plot, width = width, height = height, units = "in", dpi = dpi, bg = "white", limitsize = FALSE)
    paths <- png_path
    if (isTRUE(pdf)) {
