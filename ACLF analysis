run <- function(j) {
  for (p in c('glmnet','lightgbm','mice','pROC','digest')) stopifnot(requireNamespace(p,quietly=TRUE))
  e <- make_engine(j); dir <- e$DIRS[['audit']]
  file <- file.path(dir,'result.rds')
  if (file.exists(file)) {
    previous <- readRDS(file)
    if (identical(previous$fingerprint,e$FINGERPRINT)) return(TRUE)
  }
  log <- file(file.path(dir,'run.log'),'wt');sink(log);on.exit({sink();close(log)},add=TRUE)
  seed <- 20261024L
  if(j<=5L) {
    tr<-which(outer!=j);va<-which(outer==j); label<-paste0('outer',j)
